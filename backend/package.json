    "cors": "^2.8.5",
    "dotenv": "^17.4.1",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "rewire": "^9.0.1",
    "supertest": "^7.2.2"
  }
}
