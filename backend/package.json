{
  "name": "movie-recommendation-backend",
  "version": "1.0.0",
  "description": "Movie Recommendation System Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
